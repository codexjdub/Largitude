{
  "manifest_version": 3,
  "name": "Largitude",
  "version": "0.6.0",
  "description": "Hover over a thumbnail, a link to an image or a small video to see it full size, on any site.",
  "browser_specific_settings": {
    "gecko": {
      "id": "largitude@codexjdub.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "permissions": ["storage", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["defaults.js", "helpers.js", "background.js"] },
  "action": {
    "default_title": "Largitude",
    "default_icon": "icon.svg"
  },
  "options_ui": { "page": "options.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "helpers.js",
        "sites/image-services.js",
        "sites/amazon.js",
        "sites/bluesky.js",
        "sites/ebay.js",
        "sites/flickr.js",
        "sites/giphy.js",
        "sites/imgur.js",
        "sites/pinterest.js",
        "sites/reddit.js",
        "sites/wikipedia.js",
        "sites/x.js",
        "content.js"
      ]
    }
  ]
}
